# Copy to .env (chmod 600) and fill in. See README.md.
DATABASE_URL=postgresql://baby_tracker_app:CHANGE_ME@127.0.0.1:5432/baby_tracker
# Token signing key — random 48+ bytes. Changing it invalidates all existing logins.
APP_SECRET=CHANGE_ME
# PBKDF2-SHA256 hash of the household passphrase, "iterations$salthex$hashhex".
# Generate/rotate with server/set-passphrase.sh
PASSWORD_HASH=CHANGE_ME
