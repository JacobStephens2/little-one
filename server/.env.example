# Copy to .env (chmod 600) and fill in. See README.md.
DATABASE_URL=postgresql://baby_tracker_app:CHANGE_ME@127.0.0.1:5432/baby_tracker
# Signing key for session tokens (random 48+ bytes). Rotating it logs everyone out.
APP_SECRET=CHANGE_ME

# Transactional email (shared stephens.page Resend key)
RESEND_API_KEY=re_CHANGE_ME
BASE_URL=https://baby.stephens.page
MAIL_FROM=Little One <noreply@stephens.page>
ADMIN_EMAIL=jacob@stephens.page

# Web Push (VAPID). Generate with the snippet in README; keep the .pem out of git.
VAPID_PUBLIC=CHANGE_ME
VAPID_PRIVATE_PATH=/var/www/baby.stephens.page/server/vapid_private.pem
VAPID_SUB=mailto:jacob@stephens.page
